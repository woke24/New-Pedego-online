{%- comment -%}
  Renders a built-in divider shape. Part colors come from CSS (section-divider.css):
  .top-part, .middle-part and .bottom-part use --divider-top-fill, --divider-middle-fill and --divider-bottom-fill.

  Animated graphics (rolling_curve, glitch, chevrons, mountains) always draw the middle part, and only move when
  the Divider section adds a motion class (divider-motion-continuous or divider-motion-scroll).
  Rolling curve and Mountains draw each moving layer as its own <svg>, two periods (2880) wide, which slides by
  half its width. Moving the whole <svg> lets the browser animate it without repainting the shapes.
  Shapes run a little past the viewBox (the layers don't clip), so no seam shows at the edges while they move.
  Middle parts drawn under the bottom part stop 2 units above the bottom edge. When both parts end on the same edge,
  their anti-aliased pixels blend and the middle color shows as a hairline.

  The top part's lower edge follows the middle part's top edge (2 units lower, under the middle part), so the flips turn
  Curve into an outward or inward curve.

  Accepts:
  - graphics: {String} curve | jagged | tilted | wave | waves | fold | rolling_curve | glitch | chevrons | mountains
  - id: {String} unique id, used for the svg and the middle part gradient (see divider-gradient.liquid)
  - middle_part_color: {String} optional solid color or CSS gradient; static shapes only draw the middle part when set
  - height, width, sm_height, sm_width: {Number} mobile and desktop size (height 0 keeps the aspect ratio)
{%- endcomment -%}
{%- liquid
  case graphics
    when 'fold'
      assign view_height = 170
    when 'glitch'
      assign view_height = 200
    when 'mountains'
      assign view_height = 140
    else
      assign view_height = 120
  endcase
-%}
{%- capture gradient_definition -%}
  {%- render 'divider-gradient', id: id, middle_part_color: middle_part_color -%}
{%- endcapture -%}
{%- if gradient_definition != blank -%}
  {%- comment -%}
    Moving layers repeat every 1440 units, so a gradient is drawn as a repeating pattern that loops seamlessly:
    each period shows the gradient and its mirror image. Glitch rows only jitter, so it gets one gradient over the full width.
  {%- endcomment -%}
  {%- capture gradient_pattern -%}
    {%- if graphics == 'glitch' -%}
      <pattern id="{{ id }}-pattern" patternUnits="userSpaceOnUse" x="-80" width="1600" height="{{ view_height }}">
        <rect width="1600" height="{{ view_height }}" fill="url(#{{ id }}-gradient)"/>
      </pattern>
    {%- else -%}
      <pattern id="{{ id }}-pattern" patternUnits="userSpaceOnUse" width="1440" height="{{ view_height }}">
        <rect width="720" height="{{ view_height }}" fill="url(#{{ id }}-gradient)"/>
        <rect width="720" height="{{ view_height }}" fill="url(#{{ id }}-gradient)" transform="matrix(-1 0 0 1 1440 0)"/>
      </pattern>
    {%- endif -%}
  {%- endcapture -%}
  {%- capture layer_defs -%}
    <defs>{{ gradient_definition }}{{ gradient_pattern }}</defs>
  {%- endcapture -%}
  {%- assign pattern_fill = ' style="--divider-middle-fill: url(#' | append: id | append: '-pattern)"' -%}
{%- endif -%}

{% style %}
  #{{ id }}-svg {
    width: {{ width }}%;
    height: {% if height > 0 %}{{ height }}px{% else %}auto{% endif %};
  }
  @media only screen and (min-width: 768px) {
    #{{ id }}-svg {
      width: {{ sm_width }}%;
      height: {% if sm_height > 0 %}{{ sm_height }}px{% else %}auto{% endif %};
    }
  }
{% endstyle %}

{%- case graphics -%}
  {%- when 'rolling_curve' -%}
    <div id="{{ id }}-svg" class="divider-box divider-box--rolling-curve">
      {%- comment -%} Top and middle move together at half the speed of the bottom part, so the waves roll past each other. {%- endcomment -%}
      <svg class="divider-layer divider-slide" style="--slide-duration: 48s; --slide-loops: 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2880 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        {{ layer_defs }}
        <path class="top-part" d="M0 0V70C360 70 360 20 720 20S1080 70 1440 70S1800 20 2160 20S2520 70 2880 70S3240 20 3600 20V0Z"/>
        <path class="middle-part"{{ pattern_fill }} d="M0 118V69C360 69 360 19 720 19S1080 69 1440 69S1800 19 2160 19S2520 69 2880 69S3240 19 3600 19V118Z"/>
      </svg>
      <svg class="divider-layer divider-slide" style="--slide-duration: 24s; --slide-loops: 2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2880 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="bottom-part" d="M0 120V94C360 94 360 44 720 44S1080 94 1440 94S1800 44 2160 44S2520 94 2880 94S3240 44 3600 44V120Z"/>
      </svg>
    </div>
