{{ 'section-specs-bar.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Spec blocks. A block connected to a metaobject list is repeated by Shopify once per entry.
  assign spec_blocks = section.blocks | where: 'type', 'spec'

  # Count only the items that will be rendered
  assign items_count = 0
  for block in spec_blocks
    if block.settings.title != blank or block.settings.text != blank
      assign items_count = items_count | plus: 1
    endif
  endfor

  # Item classes
  assign item_classes = 'text-align-' | append: section.settings.alignment
  if section.settings.show_dividers
    assign item_classes = item_classes | append: ' specs-bar-divider'
  endif
  assign title_classes = section.settings.title_sm_size_multiplier | append: ' ' | append: section.settings.title_size_multiplier
  assign text_classes = section.settings.sm_size_multiplier | append: ' ' | append: section.settings.size_multiplier
-%}

{%- if items_count > 0 -%}
<div
  id="{{ section.id }}"
  class="specs-bar container section-spacing color-{{ section.settings.color_scheme }} pt pb sm-pt sm-pb"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
  ">
  {%- comment -%} The specs are term and value pairs, so the grid is a description list (see specs-bar-item.liquid). {%- endcomment -%}
  <dl class="specs-bar-list grid grid-cols-{{ section.settings.items_per_row_mobile | default: 1 }} sm-grid-cols-{{ section.settings.items_per_row_tablet }} md-grid-cols-{{ section.settings.items_per_row_desktop }}">
    {%- for block in spec_blocks -%}
      {%- liquid
        # forloop.index keeps ids unique when Shopify repeats a block for metaobject entries
        assign item_id = section.id | append: '-' | append: block.id | append: '-' | append: forloop.index
        assign item_title = block.settings.title | escape
        assign item_text = block.settings.text | escape | newline_to_br
      -%}
      {%- render 'specs-bar-item',
        title: item_title,
        text: item_text,
        tooltip: block.settings.tooltip,
        id: item_id,
        classes: item_classes,
        title_classes: title_classes,
        text_classes: text_classes,
        attributes: block.shopify_attributes -%}
    {%- endfor -%}
  </dl>
</div>
{%- endif -%}

